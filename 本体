<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YouTube リンク & yt-dlp ツール</title>
  <style>
    :root {
      --bg: #0f0f0f;
      --card: #1c1c1c;
      --accent: #ff0000;
      --text: #f1f1f1;
      --muted: #aaa;
      --border: #333;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Sans", sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 2rem 1rem;
      line-height: 1.5;
    }
    .container {
      max-width: 720px;
      margin: 0 auto;
    }
    h1 {
      text-align: center;
      font-size: 1.8rem;
      margin-bottom: 0.3rem;
    }
    .subtitle {
      text-align: center;
      color: var(--muted);
      margin-bottom: 2rem;
      font-size: 0.95rem;
    }
    .card {
      background: var(--card);
      border-radius: 16px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      border: 1px solid var(--border);
    }
    input[type="url"] {
      width: 100%;
      padding: 1rem 1.2rem;
      font-size: 1rem;
      border: 2px solid var(--border);
      border-radius: 12px;
      background: #111;
      color: var(--text);
      outline: none;
      transition: border 0.2s;
    }
    input[type="url"]:focus {
      border-color: var(--accent);
    }
    button.primary {
      width: 100%;
      margin-top: 1rem;
      padding: 1rem;
      font-size: 1.1rem;
      font-weight: 600;
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    button.primary:hover { opacity: 0.9; }
    button.primary:disabled {
      background: #555;
      cursor: not-allowed;
    }
    .result { display: none; }
    .result.show { display: block; }
    .item {
      margin-bottom: 1.2rem;
    }
    .item label {
      display: block;
      font-size: 0.85rem;
      color: var(--muted);
      margin-bottom: 0.35rem;
    }
    .value {
      display: flex;
      gap: 0.5rem;
    }
    .value input, .value textarea {
      flex: 1;
      padding: 0.7rem 1rem;
      background: #111;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 0.9rem;
      font-family: monospace;
    }
    .value textarea {
      resize: vertical;
      min-height: 70px;
    }
    .copy-btn {
      padding: 0.7rem 1rem;
      background: #333;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.85rem;
      white-space: nowrap;
    }
    .copy-btn:hover { background: #444; }
    .meta {
      display: flex;
      gap: 1.2rem;
      align-items: flex-start;
      margin-top: 1rem;
    }
    .meta img {
      width: 160px;
      border-radius: 10px;
      flex-shrink: 0;
    }
    .meta-info {
      flex: 1;
    }
    .meta-info h2 {
      font-size: 1.1rem;
      margin-bottom: 0.3rem;
    }
    .meta-info p {
      color: var(--muted);
      font-size: 0.9rem;
    }
    .commands {
      background: #111;
      border-radius: 10px;
      padding: 1rem;
      margin-top: 1rem;
    }
    .commands h3 {
      font-size: 0.95rem;
      margin-bottom: 0.8rem;
      color: var(--muted);
    }
    .cmd {
      margin-bottom: 0.8rem;
    }
    .cmd code {
      display: block;
      background: #1a1a1a;
      padding: 0.6rem 0.8rem;
      border-radius: 6px;
      font-size: 0.85rem;
      overflow-x: auto;
      white-space: nowrap;
    }
    .error {
      color: #ff6b6b;
      text-align: center;
      margin-top: 1rem;
    }
    footer {
      text-align: center;
      color: var(--muted);
      font-size: 0.85rem;
      margin-top: 2rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>YouTube リンク & yt-dlp ツール</h1>
    <p class="subtitle">URLを貼るだけでリンク整理 + ダウンロードコマンド生成</p>

    <div class="card">
      <input type="url" id="urlInput" placeholder="https://www.youtube.com/watch?v=... または youtu.be/..." autocomplete="off">
      <button class="primary" id="getBtn">取得する</button>
      <div id="error" class="error"></div>
    </div>

    <div id="result" class="result">
      <div class="card">
        <div class="meta" id="metaArea" style="display:none;">
          <img id="thumb" alt="thumbnail">
          <div class="meta-info">
            <h2 id="title"></h2>
            <p id="channel"></p>
          </div>
        </div>

        <div class="item">
          <label>正規リンク</label>
          <div class="value">
            <input type="text" id="watchLink" readonly>
            <button class="copy-btn" data-target="watchLink">コピー</button>
          </div>
        </div>

        <div class="item">
          <label>短いリンク</label>
          <div class="value">
            <input type="text" id="shortLink" readonly>
            <button class="copy-btn" data-target="shortLink">コピー</button>
          </div>
        </div>

        <div class="item">
          <label>埋め込みコード</label>
          <div class="value">
            <textarea id="embedCode" readonly></textarea>
            <button class="copy-btn" data-target="embedCode">コピー</button>
          </div>
        </div>

        <div class="commands">
          <h3>yt-dlp コマンド（コピーしてPCで実行）</h3>
          
          <div class="cmd">
            <label>最高画質（推奨）</label>
            <div class="value">
              <input type="text" id="cmdBest" readonly>
              <button class="copy-btn" data-target="cmdBest">コピー</button>
            </div>
          </div>

          <div class="cmd">
            <label>1080pまで</label>
            <div class="value">
              <input type="text" id="cmd1080" readonly>
              <button class="copy-btn" data-target="cmd1080">コピー</button>
            </div>
          </div>

          <div class="cmd">
            <label>音声だけ（MP3）</label>
            <div class="value">
              <input type="text" id="cmdMp3" readonly>
              <button class="copy-btn" data-target="cmdMp3">コピー</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <footer>
      GitHub + Cloudflare Pages で動作 / データは一切送信されません
    </footer>
  </div>

  <script>
    const urlInput = document.getElementById('urlInput');
    const getBtn = document.getElementById('getBtn');
    const errorEl = document.getElementById('error');
    const resultEl = document.getElementById('result');

    function extractVideoId(url) {
      try {
        const u = new URL(url.trim());
        if (u.hostname.includes('youtu.be')) {
          return u.pathname.slice(1).split(/[?&]/)[0];
        }
        if (u.hostname.includes('youtube.com') || u.hostname.includes('youtube-nocookie.com')) {
          if (u.pathname === '/watch') return u.searchParams.get('v');
          if (u.pathname.startsWith('/embed/')) return u.pathname.split('/')[2];
          if (u.pathname.startsWith('/shorts/')) return u.pathname.split('/')[2];
          if (u.pathname.startsWith('/live/')) return u.pathname.split('/')[2];
        }
      } catch (e) {}
      const match = url.match(/(?:v=|\/)([0-9A-Za-z_-]{11})/);
      return match ? match[1] : null;
    }

    async function getInfo(videoId) {
      const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
      try {
        const res = await fetch(`https://www.youtube.com/oembed?url=${encodeURIComponent(watchUrl)}&format=json`);
        if (!res.ok) return null;
        return await res.json();
      } catch {
        return null;
      }
    }

    function copyText(id) {
      const el = document.getElementById(id);
      el.select();
      navigator.clipboard.writeText(el.value).then(() => {
        const btn = document.querySelector(`[data-target="${id}"]`);
        const old = btn.textContent;
        btn.textContent = 'コピー済';
        setTimeout(() => btn.textContent = old, 1500);
      });
    }

    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => copyText(btn.dataset.target));
    });

    async function process() {
      errorEl.textContent = '';
      resultEl.classList.remove('show');
      getBtn.disabled = true;
      getBtn.textContent = '取得中...';

      const id = extractVideoId(urlInput.value);
      if (!id || id.length !== 11) {
        errorEl.textContent = '有効なYouTubeのURLを入力してください';
        getBtn.disabled = false;
        getBtn.textContent = '取得する';
        return;
      }

      const watch = `https://www.youtube.com/watch?v=${id}`;
      const short = `https://youtu.be/${id}`;
      const embed = `<iframe width="560" height="315" src="https://www.youtube.com/embed/${id}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;

      document.getElementById('watchLink').value = watch;
      document.getElementById('shortLink').value = short;
      document.getElementById('embedCode').value = embed;

      // yt-dlp commands
      document.getElementById('cmdBest').value = `yt-dlp "${watch}"`;
      document.getElementById('cmd1080').value = `yt-dlp -f "bestvideo[height<=1080]+bestaudio/best" --merge-output-format mp4 "${watch}"`;
      document.getElementById('cmdMp3').value = `yt-dlp -x --audio-format mp3 "${watch}"`;

      // meta
      const info = await getInfo(id);
      const metaArea = document.getElementById('metaArea');
      if (info) {
        document.getElementById('title').textContent = info.title;
        document.getElementById('channel').textContent = info.author_name;
        document.getElementById('thumb').src = `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
        metaArea.style.display = 'flex';
      } else {
        metaArea.style.display = 'none';
      }

      resultEl.classList.add('show');
      getBtn.disabled = false;
      getBtn.textContent = '取得する';
    }

    getBtn.addEventListener('click', process);
    urlInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') process();
    });
  </script>
</body>
</html>
